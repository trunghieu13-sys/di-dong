@model IReadOnlyList<ToeicAdmin.Models.AppUser>
@{
    ViewData["Title"] = "Tài khoản và quyền";
}
<div class="mb-4"><h1 class="h3 mb-1">Tài khoản và phân quyền</h1><p class="text-secondary">Cấp quyền Admin hoặc User cho tài khoản đã đăng ký.</p></div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
<thead class="table-light"><tr><th class="ps-4">Tài khoản</th><th>Ngày tạo</th><th>Quyền</th><th class="text-end pe-4">Thay đổi quyền</th></tr></thead><tbody>
@foreach (var user in Model) { var role = user.UserRoles.FirstOrDefault()?.Role.Name ?? "User";
<tr><td class="ps-4"><strong>@user.DisplayName</strong><div class="small text-secondary">@user.Email</div></td><td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="badge @(role == "Admin" ? "text-bg-primary" : "text-bg-secondary")">@role</span></td><td class="text-end pe-4"><form asp-action="SetRole" method="post" class="d-inline-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="userId" value="@user.Id" /><select class="form-select form-select-sm" name="roleName"><option value="User" selected="@(role == "User")">User</option><option value="Admin" selected="@(role == "Admin")">Admin</option></select><button class="btn btn-sm btn-outline-primary" type="submit">Lưu</button></form></td></tr>
}
</tbody></table></div></div>
